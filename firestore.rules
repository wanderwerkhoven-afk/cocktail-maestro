rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.Admin == true;
    }

    match /users/{userId} {
      // Allow user to read their own data, or admin to read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Allow user to create their own record, but NOT set Admin to true
      // We check if Admin is not present or is false
      allow create: if request.auth != null && request.auth.uid == userId && 
        (!request.resource.data.keys().hasAll(['Admin']) || request.resource.data.Admin == false);
      
      // Allow user to update their own record, but NOT change the Admin field
      // The new value of Admin must match the old value
      allow update: if request.auth != null && request.auth.uid == userId && 
        (request.resource.data.Admin == resource.data.Admin);
      
      // Admin can do anything
      allow write: if isAdmin();
    }

    // Publicly readable collections, Admin-only write
    match /Cocktail-db/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Mocktail-db/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /Kitchen-db/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Publicly readable news, Admin-only write
    match /news/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-only TO DO list
    match /admin-todos/{todoId} {
      allow read, write: if isAdmin();
    }
  }
}
