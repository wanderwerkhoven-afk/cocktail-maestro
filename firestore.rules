rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Beveiliging voor Cocktail Maestro gebruikersgegevens
    match /users/{userId} {
      // Gebruikers mogen alleen hun eigen bar stock en recepten lezen en schrijven
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Toekomstige gedeelde recepten kunnen hier worden toegevoegd
    // match /shared_recipes/{recipeId} {
    //   allow read: if true;
    // }
  }
}
